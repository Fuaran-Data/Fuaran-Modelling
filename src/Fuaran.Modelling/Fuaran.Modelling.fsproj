<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Fuaran.Modelling</PackageId>
    <Description>Fuaran.Modelling — the spec-agnostic model manager: the decision record over statistical / econometric model specs. A branching exploration op-DAG (fork, return-to-ancestor, cherry-pick, curate) with deterministic path replay, curation records, self-contained outcome snapshots keyed by a composite join key, party-scoped assent with derived consensus and a tension surface over the two quality axes, and a default-deny policy layer over the op vocabulary, fit submission and each declared party class. The spec payload is opaque throughout — no estimator, no model vocabulary, no framework. Composition over Fuaran.Core; FSharp.Core only.</Description>
    <PackageTags>modelling;exploration;op-stream;dag;provenance;governance;fsharp</PackageTags>
    <!-- An incomplete match is not a style note: the missing case throws at runtime, and the
         op vocabulary + refusal enumerations are the whole point of a closed algebra. -->
    <WarningsAsErrors>FS0025;$(WarningsAsErrors)</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="Ops.fs" />
    <Compile Include="Reducer.fs" />
    <Compile Include="Policy.fs" />
    <!-- Forest reads a folded exploration (Reducer's Query) and holds the shared policy, so
         it follows both; nothing below it knows a forest exists. -->
    <Compile Include="Forest.fs" />
    <!-- The consensual axis reads a folded exploration (Query), the declared party classes
         (Policy) and rolls up across a forest, so it follows all three; nothing below it
         knows assent exists. -->
    <Compile Include="Assent.fs" />
    <Compile Include="Backend.fs" />
    <!-- The vintage axis builds fit submissions (Backend) and rolls a forest's recurrence up
         (Forest), so it follows both; it reads folded records and changes none of them. -->
    <Compile Include="Vintage.fs" />
    <!-- Wire encodes the policy + execution-seam records too, so it follows both. -->
    <Compile Include="Wire.fs" />
    <Compile Include="Session.fs" />
    <Compile Include="Contract.fs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Fuaran.Core.OpStream" />
    <PackageReference Include="Fuaran.Core.OpStream.Dag" />
    <PackageReference Include="Fuaran.Core.Wire" />
    <PackageReference Include="Fuaran.Core.Unit" />
  </ItemGroup>
</Project>
